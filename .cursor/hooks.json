{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "python3 .cursor/hooks/run-ci.py",
        "loop_limit": 5,
        "timeout": 60
      }
    ],
    "preToolUse": [
      {
        "command": "python3 .cursor/hooks/run-ci.py",
        "matcher": "Write|StrReplace|Delete",
        "timeout": 60
      }
    ]
  }
}
